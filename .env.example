# ============================================================
# KEWEE MASCOTAS — Variables de entorno
# Copia este archivo como .env.local y completa los valores.
# NUNCA subir .env.local a GitHub.
# ============================================================

# ---------- Supabase ----------
# URL y clave anónima del proyecto (públicas, protegidas por RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio — SOLO SERVIDOR. Ignora RLS. Nunca exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Panel Admin (FASE 6A) ----------
# Allowlist server-only de correos autorizados para /admin.
# Separar varios con comas. Ejemplo: ADMIN_EMAILS=admin@keweepets.com,otro@keweepets.com
# Si se omite o queda vacía, NADIE puede entrar al panel (fail-closed).
ADMIN_EMAILS=

# ---------- Mercado Pago (Fase 7) ----------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ---------- Resend — emails transaccionales (Fase 6) ----------
RESEND_API_KEY=

# ---------- WhatsApp ----------
# Número en formato internacional sin "+", espacios ni guiones.
# Ejemplo Colombia: 573001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---------- Sitio ----------
# URL pública del sitio (para metadata/SEO). En producción: https://tudominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
